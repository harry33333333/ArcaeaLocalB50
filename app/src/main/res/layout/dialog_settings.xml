<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 玩家昵称 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="玩家昵称"
            android:textColor="#BB86FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_setting_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如: Hikari"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <!-- 好友 ID -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="好友 ID"
            android:textColor="#BB86FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_setting_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如: 100 000 001"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp"
            android:singleLine="true"
            android:layout_marginBottom="10dp" />

        <CheckBox
            android:id="@+id/cb_setting_show_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="在长图中显示好友 ID"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:checked="true"
            android:layout_marginBottom="14dp" />

        <!-- 段位挑战框选择 (全40档 + 不显示) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="段位挑战框 (全40档 + 不显示)"
            android:textColor="#BB86FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#201E32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/iv_current_dan_preview"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:scaleType="fitCenter"
                android:background="#151322"
                android:contentDescription="段位框预览" />

            <TextView
                android:id="@+id/tv_current_dan_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前段位: Course Dan 1"
                android:textColor="#D0D0E8"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btn_select_dan"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:text="🎖️ 浏览并选择段位框 (全40档图库)"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 预设头像选择 (全头像画廊预览) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="预设头像"
            android:textColor="#BB86FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:background="#201E32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/iv_preview_dialog_avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop"
                android:background="#151322"
                android:padding="2dp"
                android:contentDescription="头像预览" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_preview_dialog_avatar_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前: 34u_icon.webp"
                    android:textColor="#D0D0E8"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_select_avatar"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:text="🖼️ 打开头像图库画廊选择"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 长图背景选择 (全背景画廊预览) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="长图背景"
            android:textColor="#BB86FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#201E32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/iv_preview_dialog_bg"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:background="#151322"
                android:contentDescription="背景预览" />

            <TextView
                android:id="@+id/tv_preview_dialog_bg_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="当前: s9.webp"
                android:textColor="#D0D0E8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_select_bg"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:text="🌄 打开背景图库画廊选择"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 出图曲目数量 (默认 60，50+10，5 个为单位) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="出图曲目数量 (默认 60 即 Best 50 + Over 10，最低 50，以 5 为步长)"
            android:textColor="#BB86FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_setting_quantity_preset"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp" />

            <EditText
                android:id="@+id/et_setting_quantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="60"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:hint="数量 (50, 55, 60, 65...)"
                android:textColorHint="@color/text_hint"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <!-- 界面主题模式 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="界面主题模式"
                android:textColor="#BB86FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sp_setting_app_theme"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <!-- 长图生成卡片风格 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="B50 长图卡片出图风格"
                android:textColor="#BB86FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sp_setting_image_theme"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>
